{
  "@typescript-eslint/no-explicit-any": 202,
  "@typescript-eslint/no-shadow": 16,
  "@typescript-eslint/no-unused-vars": 443,
  "arrow-body-style": 101,
  "curly": 5,
  "import/newline-after-import": 3,
  "import/no-cycle": 13,
  "import/no-duplicates": 12,
  "import/no-named-as-default": 54,
  "import/no-restricted-paths": 40,
  "import/order": 125,
  "jsx-a11y/alt-text": 2,
  "max-lines": 33,
  "new-cap": 1,
  "no-alert": 4,
  "no-console": 17,
  "no-else-return": 1,
  "no-extra-boolean-cast": 1,
  "no-lonely-if": 1,
  "no-multi-assign": 2,
  "no-plusplus": 5,
  "no-restricted-exports": 9,
  "no-restricted-globals": 1,
  "no-restricted-imports": 16,
  "no-restricted-properties": 1,
  "no-useless-escape": 2,
  "no-useless-return": 1,
  "object-shorthand": 3,
  "parse-error": 1,
  "prefer-const": 7,
  "prefer-destructuring": 2,
  "prefer-exponentiation-operator": 1,
  "radix": 1,
  "react/button-has-type": 1,
  "react/jsx-boolean-value": 16,
  "react/jsx-curly-brace-presence": 16,
  "react/no-unescaped-entities": 2
}
