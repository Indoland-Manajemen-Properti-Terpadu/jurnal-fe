{
  "@typescript-eslint/no-explicit-any": 91,
  "@typescript-eslint/no-shadow": 11,
  "@typescript-eslint/no-unused-vars": 204,
  "arrow-body-style": 55,
  "curly": 2,
  "import/newline-after-import": 2,
  "import/no-cycle": 9,
  "import/no-duplicates": 10,
  "import/no-named-as-default": 17,
  "import/no-restricted-paths": 10,
  "import/order": 53,
  "jsx-a11y/alt-text": 2,
  "max-lines": 8,
  "new-cap": 1,
  "no-alert": 4,
  "no-console": 7,
  "no-extra-boolean-cast": 1,
  "no-multi-assign": 2,
  "no-restricted-exports": 9,
  "no-restricted-imports": 1,
  "object-shorthand": 2,
  "prefer-destructuring": 1,
  "radix": 1,
  "react/button-has-type": 1,
  "react/jsx-boolean-value": 12,
  "react/jsx-curly-brace-presence": 11,
  "react/no-unescaped-entities": 2
}
