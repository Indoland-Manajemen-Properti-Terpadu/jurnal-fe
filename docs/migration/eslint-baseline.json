{
  "@typescript-eslint/no-explicit-any": 67,
  "@typescript-eslint/no-shadow": 4,
  "@typescript-eslint/no-unused-vars": 82,
  "arrow-body-style": 23,
  "curly": 1,
  "import/newline-after-import": 1,
  "import/no-cycle": 7,
  "import/no-duplicates": 4,
  "import/no-named-as-default": 13,
  "import/no-restricted-paths": 10,
  "import/order": 27,
  "jsx-a11y/alt-text": 2,
  "max-lines": 4,
  "new-cap": 1,
  "no-alert": 3,
  "no-console": 6,
  "no-extra-boolean-cast": 1,
  "no-multi-assign": 2,
  "no-restricted-exports": 9,
  "no-restricted-imports": 1,
  "radix": 1,
  "react/button-has-type": 1,
  "react/jsx-boolean-value": 9,
  "react/jsx-curly-brace-presence": 3
}
