{
  "@typescript-eslint/no-explicit-any": 98,
  "@typescript-eslint/no-shadow": 14,
  "@typescript-eslint/no-unused-vars": 277,
  "arrow-body-style": 70,
  "curly": 3,
  "import/newline-after-import": 2,
  "import/no-cycle": 9,
  "import/no-duplicates": 12,
  "import/no-named-as-default": 28,
  "import/no-restricted-paths": 12,
  "import/order": 60,
  "jsx-a11y/alt-text": 2,
  "max-lines": 16,
  "new-cap": 1,
  "no-alert": 4,
  "no-console": 7,
  "no-extra-boolean-cast": 1,
  "no-multi-assign": 2,
  "no-restricted-exports": 9,
  "no-restricted-imports": 6,
  "object-shorthand": 2,
  "parse-error": 1,
  "prefer-destructuring": 1,
  "radix": 1,
  "react/button-has-type": 1,
  "react/jsx-boolean-value": 13,
  "react/jsx-curly-brace-presence": 12,
  "react/no-unescaped-entities": 2
}
