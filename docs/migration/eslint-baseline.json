{
  "@typescript-eslint/no-explicit-any": 180,
  "@typescript-eslint/no-shadow": 14,
  "@typescript-eslint/no-unused-vars": 363,
  "arrow-body-style": 92,
  "curly": 5,
  "import/newline-after-import": 3,
  "import/no-cycle": 9,
  "import/no-duplicates": 12,
  "import/no-named-as-default": 37,
  "import/no-restricted-paths": 17,
  "import/order": 90,
  "jsx-a11y/alt-text": 2,
  "max-lines": 27,
  "new-cap": 1,
  "no-alert": 4,
  "no-console": 16,
  "no-else-return": 1,
  "no-extra-boolean-cast": 1,
  "no-lonely-if": 1,
  "no-multi-assign": 2,
  "no-plusplus": 2,
  "no-restricted-exports": 9,
  "no-restricted-imports": 16,
  "no-restricted-properties": 1,
  "no-useless-return": 1,
  "object-shorthand": 3,
  "parse-error": 1,
  "prefer-const": 7,
  "prefer-destructuring": 1,
  "prefer-exponentiation-operator": 1,
  "radix": 1,
  "react/button-has-type": 1,
  "react/jsx-boolean-value": 15,
  "react/jsx-curly-brace-presence": 12,
  "react/no-unescaped-entities": 2
}
